// Block 7, Step 7.2: Native Vulkan 1.3 GLSL replacement for cs 0x00000000a954e79d
// (Particle DispatchIndirect workgroup-count & GDS counter preparation, 24 dispatches/frame).
// Replaces 32-lane redundant stores (288 stores) + per-group atomicAdd loop with single-lane write + 1 atomicAdd.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform AuxData {
    float xoffset;
    float yoffset;
    float xscale;
    float yscale;
    uvec4 ud_regs0;
    uvec4 ud_regs1;
    uvec4 ud_regs2;
    uvec4 ud_regs3;
    uvec4 buf_offsets0;
    uvec4 buf_offsets1;
    uvec2 buf_offsets2;
    uint motion_param;
    uint scene_size;
} push_data;

layout(set = 0, binding = 0, std430) readonly buffer SSBO1 {
    uint data[];
} ssbo_1;

layout(set = 0, binding = 1, std430) buffer SSBO2 {
    uint data[];
} ssbo_2;

layout(set = 0, binding = 2, std430) buffer GDS {
    uint data[];
} gds_buffer;

void main() {
    if (gl_LocalInvocationID.x == 0u && gl_LocalInvocationID.y == 0u && gl_LocalInvocationID.z == 0u) {
        const uint buf0_dw = (push_data.buf_offsets0.x & 0xFFu) >> 2;
        const uint buf1_dw = ((push_data.buf_offsets0.x >> 8) & 0xFFu) >> 2;
        const uint count = ssbo_1.data[buf0_dw];
        const uint groups = (count + 31u) >> 5;
        ssbo_2.data[buf1_dw + 0u] = groups;
        ssbo_2.data[buf1_dw + 1u] = 1u;
        ssbo_2.data[buf1_dw + 2u] = 1u;
        if (groups > 0u) {
            const uint gds_dw = (push_data.ud_regs0.x >> 16) >> 2;
            atomicAdd(gds_buffer.data[gds_dw], groups);
        }
    }
}
