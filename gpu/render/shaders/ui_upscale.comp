// bbport: Hybrid GPU UI & Icon Super-Resolution (2x / 4x):
//   1. 4x4 Block-Boundary Bilateral De-Blocking (removes DXT1/BC3/BC7 4x4 blocks & RGB565 quantization)
//   2. Alpha-Safe Premultiplied RGB Neighborhood Sampling (prevents transparent border dark fringes)
//   3. xBRZ / EASU-style Diagonal & Anisotropic Structure-Tensor Bicubic Reconstruction
//   4. Anime4K-style Sub-Pixel Edge Thinning & Micro-Detail Residual Enhancement (with Anti-Ringing)
//   5. Signed Distance Field (SDF) Contour Reconstruction for Alpha Masks & Monochrome Typography
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D src_tex;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst_img;

layout(push_constant) uniform PushConstants {
    ivec2 src_size;
    ivec2 dst_size;
    int scale_factor;
    int is_block;
} pc;

float Luma(vec3 rgb) {
    return dot(rgb, vec3(0.299, 0.587, 0.114));
}

float ColorDist(vec4 a, vec4 b) {
    vec3 da = (a.rgb - b.rgb) * max(max(a.a, b.a), 0.15);
    float dl = abs(Luma(a.rgb) - Luma(b.rgb));
    float d_alpha = abs(a.a - b.a) * 1.35;
    return sqrt(dot(da, da) + dl * dl * 0.5 + d_alpha * d_alpha);
}

vec4 FetchClamped(ivec2 c) {
    return texelFetch(src_tex, clamp(c, ivec2(0), pc.src_size - 1), 0);
}

// 1. Bilateral 4x4 BC1/BC3/BC7 De-Blocking: smooths small quantization steps across 4x4 block
// boundaries while keeping real edges and micro-details 100% intact.
vec4 FetchDeblocked(ivec2 c) {
    vec4 center = FetchClamped(c);
    if (pc.is_block == 0) {
        return center;
    }
    ivec2 mod4 = c & 3;
    bool on_x_edge = (mod4.x == 0 || mod4.x == 3);
    bool on_y_edge = (mod4.y == 0 || mod4.y == 3);
    if (!on_x_edge && !on_y_edge) {
        return center;
    }
    vec4 n_left  = FetchClamped(c + ivec2(-1, 0));
    vec4 n_right = FetchClamped(c + ivec2( 1, 0));
    vec4 n_up    = FetchClamped(c + ivec2( 0,-1));
    vec4 n_down  = FetchClamped(c + ivec2( 0, 1));

    // Range sigma tuned specifically for 5:6:5 / BC endpoint quantization noise (~0.035).
    const float inv_sigma2 = 1.0 / (0.042 * 0.042);
    float w_l = on_x_edge ? exp(-ColorDist(center, n_left)  * ColorDist(center, n_left)  * inv_sigma2) * 0.22 : 0.0;
    float w_r = on_x_edge ? exp(-ColorDist(center, n_right) * ColorDist(center, n_right) * inv_sigma2) * 0.22 : 0.0;
    float w_u = on_y_edge ? exp(-ColorDist(center, n_up)    * ColorDist(center, n_up)    * inv_sigma2) * 0.22 : 0.0;
    float w_d = on_y_edge ? exp(-ColorDist(center, n_down)  * ColorDist(center, n_down)  * inv_sigma2) * 0.22 : 0.0;

    float w_sum = 1.0 + w_l + w_r + w_u + w_d;
    return (center + w_l * n_left + w_r * n_right + w_u * n_up + w_d * n_down) / w_sum;
}

// Catmull-Rom cubic weights for t in [0, 1]
vec4 CubicCatmullRom(float t) {
    float t2 = t * t;
    float t3 = t2 * t;
    return vec4(
        -0.5 * t + t2 - 0.5 * t3,
         1.0 - 2.5 * t2 + 1.5 * t3,
         0.5 * t + 2.0 * t2 - 1.5 * t3,
        -0.5 * t2 + 0.5 * t3
    );
}

void main() {
    ivec2 dst_pos = ivec2(gl_GlobalInvocationID.xy);
    if (dst_pos.x >= pc.dst_size.x || dst_pos.y >= pc.dst_size.y) {
        return;
    }

    vec2 src_f = (vec2(dst_pos) + 0.5) / float(pc.scale_factor) - 0.5;
    ivec2 base = ivec2(floor(src_f));
    vec2 f = clamp(src_f - vec2(base), 0.0, 1.0);

    // Load 4x4 de-blocked source neighborhood p[y][x] for y,x in 0..3 (representing base - 1 .. base + 2)
    vec4 p[4][4];
    for (int jy = 0; jy < 4; ++jy) {
        for (int jx = 0; jx < 4; ++jx) {
            p[jy][jx] = FetchDeblocked(base + ivec2(jx - 1, jy - 1));
        }
    }

    vec4 c00 = p[1][1];
    vec4 c10 = p[1][2];
    vec4 c01 = p[2][1];
    vec4 c11 = p[2][2];

    // Fast path for completely uniform 2x2 interior / transparent regions
    float max_a = max(max(c00.a, c10.a), max(c01.a, c11.a));
    if (max_a < 1.0 / 512.0) {
        imageStore(dst_img, dst_pos, vec4(0.0));
        return;
    }

    // 2. Alpha-Aware RGB Bleed Prevention: if some texels in the 4x4 window have near-zero alpha
    // while the central 2x2 has visible opacity, replace transparent RGB with the nearest opaque
    // RGB in the 2x2 cell so black (0,0,0,0) background never bleeds dark fringes into icon edges.
    if (max_a > 0.02) {
        vec3 fallback_rgb = vec3(0.0);
        float fallback_w = 0.0;
        vec4 core[4] = vec4[4](c00, c10, c01, c11);
        for (int i = 0; i < 4; ++i) {
            float w = core[i].a * core[i].a;
            fallback_rgb += core[i].rgb * w;
            fallback_w += w;
        }
        if (fallback_w > 1e-5) {
            fallback_rgb /= fallback_w;
            for (int jy = 0; jy < 4; ++jy) {
                for (int jx = 0; jx < 4; ++jx) {
                    float a_ratio = clamp(p[jy][jx].a / max(max_a * 0.25, 0.02), 0.0, 1.0);
                    p[jy][jx].rgb = mix(fallback_rgb, p[jy][jx].rgb, a_ratio);
                }
            }
            c00 = p[1][1];
            c10 = p[1][2];
            c01 = p[2][1];
            c11 = p[2][2];
        }
    }

    // 3. Bicubic Catmull-Rom interpolation with Alpha-Weighted RGB
    vec4 wx = CubicCatmullRom(f.x);
    vec4 wy = CubicCatmullRom(f.y);
    vec4 bicubic = vec4(0.0);
    for (int jy = 0; jy < 4; ++jy) {
        vec4 row = p[jy][0] * wx.x + p[jy][1] * wx.y + p[jy][2] * wx.z + p[jy][3] * wx.w;
        bicubic += row * wy[jy];
    }

    // 4. xBRZ / Diagonal Structure Reconstruction for 45-degree and 26.5-degree edges
    // Compare main diagonal (c00 <-> c11) vs anti-diagonal (c10 <-> c01) with 4x4 context support
    float diag_main = ColorDist(c00, c11) +
                      0.35 * (ColorDist(p[0][1], p[1][2]) + ColorDist(p[1][0], p[2][1]) +
                              ColorDist(p[1][2], p[2][3]) + ColorDist(p[2][1], p[3][2]));
    float diag_anti = ColorDist(c10, c01) +
                      0.35 * (ColorDist(p[0][2], p[1][1]) + ColorDist(p[1][3], p[2][2]) +
                              ColorDist(p[1][1], p[2][0]) + ColorDist(p[2][2], p[3][1]));

    vec4 bilinear = mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
    vec4 diag_interp = bilinear;

    float diag_diff = abs(diag_main - diag_anti);
    float diag_sum  = diag_main + diag_anti + 1e-4;
    float diag_strength = smoothstep(0.08, 0.35, diag_diff / diag_sum) *
                          smoothstep(0.02, 0.12, diag_diff);

    if (diag_main < diag_anti) {
        // Edge runs along main diagonal (top-left c00 to bottom-right c11)
        float t_diag = 0.5 * (f.x + f.y);
        vec4 d_mid = mix(c00, c11, t_diag);
        vec4 d_corner = (f.x > f.y)
            ? mix(d_mid, c10, clamp(f.x - f.y, 0.0, 1.0))
            : mix(d_mid, c01, clamp(f.y - f.x, 0.0, 1.0));
        diag_interp = d_corner;
    } else if (diag_anti < diag_main) {
        // Edge runs along anti-diagonal (top-right c10 to bottom-left c01)
        float t_anti = 0.5 * ((1.0 - f.x) + f.y);
        vec4 d_mid = mix(c10, c01, t_anti);
        float s = f.x + f.y;
        vec4 d_corner = (s < 1.0)
            ? mix(c00, d_mid, clamp(s, 0.0, 1.0))
            : mix(d_mid, c11, clamp(s - 1.0, 0.0, 1.0));
        diag_interp = d_corner;
    }

    // Blend Catmull-Rom bicubic with xBRZ diagonal reconstruction
    vec4 combined = mix(bicubic, diag_interp, diag_strength * 0.65);

    // 5. Anime4K-style Sub-Pixel Edge Thinning & Micro-Detail Push (with Strict Anti-Ringing)
    vec4 box_min = min(min(c00, c10), min(c01, c11));
    vec4 box_max = max(max(c00, c10), max(c01, c11));
    vec4 box_mid = 0.5 * (box_min + box_max);
    vec4 box_span = box_max - box_min;

    // Push sub-pixel transitions slightly toward the nearest local extremum (edge thinning)
    // so 1x blurry slopes become crisp 2x/4x edges without creating halos outside [box_min, box_max].
    vec4 rel = clamp((combined - box_min) / max(box_span, vec4(1e-4)), 0.0, 1.0);
    vec4 s_curve = smoothstep(0.0, 1.0, rel);
    // Sharpen RGB transitions proportional to local contrast
    float rgb_contrast = max(max(box_span.r, box_span.g), box_span.b);
    float edge_push = smoothstep(0.03, 0.25, rgb_contrast) * 0.38;
    vec3 pushed_rgb = mix(combined.rgb, box_min.rgb + s_curve.rgb * box_span.rgb, edge_push);

    // High-frequency micro-detail residual from 4x4 neighborhood (unsharp mask clamped to avoid halos)
    vec3 laplacian = combined.rgb - bilinear.rgb;
    vec3 final_rgb = pushed_rgb + laplacian * 0.28;
    // Strict anti-ringing clamp (allows at most 1.5% overshoot of local 2x2 range)
    vec3 overshoot = box_span.rgb * 0.015;
    final_rgb = clamp(final_rgb, box_min.rgb - overshoot, box_max.rgb + overshoot);

    // 6. Signed Distance Field (SDF) Contour Reconstruction for Alpha Channel & Monochrome Glyphs
    // In Bloodborne, the Title Screen Logo ("Bloodborne"), runes, status icons, and item silhouettes
    // use the alpha channel (or monochrome luminance) as a contour mask.
    float alpha_span = box_span.a;
    float final_alpha = combined.a;
    if (alpha_span > 0.06) {
        // Compute normalized signed distance t_a in [0, 1] across the local 2x2 contour transition
        float t_a = clamp((diag_interp.a - box_min.a) / max(alpha_span, 1e-4), 0.0, 1.0);
        // Steepness scales with scale_factor (2x or 4x) to yield a 1-output-pixel anti-aliased vector edge
        float sdf_steepness = mix(1.0, float(pc.scale_factor) * 0.58, smoothstep(0.06, 0.30, alpha_span));
        float sdf_t = clamp((t_a - 0.5) * sdf_steepness + 0.5, 0.0, 1.0);
        float sdf_a = box_min.a + smoothstep(0.0, 1.0, sdf_t) * alpha_span;
        final_alpha = mix(combined.a, sdf_a, 0.82);
    }
    final_alpha = clamp(final_alpha, box_min.a, box_max.a);

    // Also apply subtle SDF contour sharpening to monochrome typography / line-art in RGB
    float sat = max(max(box_mid.r, box_mid.g), box_mid.b) - min(min(box_mid.r, box_mid.g), box_mid.b);
    if (sat < 0.08 && rgb_contrast > 0.12) {
        vec3 t_rgb = clamp((diag_interp.rgb - box_min.rgb) / max(box_span.rgb, vec3(1e-4)), 0.0, 1.0);
        float mono_steep = float(pc.scale_factor) * 0.45;
        vec3 sdf_rgb_t = clamp((t_rgb - 0.5) * mono_steep + 0.5, 0.0, 1.0);
        vec3 sdf_rgb = box_min.rgb + smoothstep(0.0, 1.0, sdf_rgb_t) * box_span.rgb;
        final_rgb = mix(final_rgb, sdf_rgb, 0.45);
    }

    imageStore(dst_img, dst_pos, clamp(vec4(final_rgb, final_alpha), 0.0, 1.0));
}
